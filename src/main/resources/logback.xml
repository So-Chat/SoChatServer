<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>[%d{HH:mm:ss}] %-5level%logger - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="com.zaxxer.hikari" level="WARN" />
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
